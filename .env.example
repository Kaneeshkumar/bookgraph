# Server Configuration
PORT=3000

# Neo4j Database Connection
# If using local Neo4j Desktop or Docker:
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password
NEO4J_DATABASE=neo4j

# If using Neo4j AuraDB (Free Cloud):
# NEO4J_URI=neo4j+s://<your-aura-db-instance-id>.databases.neo4j.io
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=<your-aura-password>
